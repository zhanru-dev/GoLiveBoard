{
	# On the AWS host (infra/deploy/docker-compose.aws.yml): a public site with
	# a certificate from Let's Encrypt, obtained and renewed by Caddy, which
	# also redirects plain HTTP to HTTPS. The DNS CAA record allows Let's
	# Encrypt only (infra/terraform/modules/dns).
	# The admin API stays inside the container; the health check uses it.
	admin localhost:2019
}

(upstream_transport) {
	transport http {
		# Close idle connections to an upstream before Node.js does (its
		# keep-alive timeout is 5 seconds), so a reused connection is never one
		# Node is closing.
		keepalive 4s
	}
}

{$SITE_HOST} {
	header {
		# Browsers refuse plain HTTP to this host and its subdomains for a year.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Methods no page or API uses (docs/security-review.md, F4); first, as
	# handle blocks run before respond.
	@unused_method method TRACE TRACK CONNECT
	handle @unused_method {
		respond 405
	}

	encode zstd gzip

	# A new ID for every request, set here and never taken from the client.
	request_header X-Request-Id {http.request.uuid}

	@api path /api/* /realtime /realtime/*
	handle @api {
		reverse_proxy {$API_UPSTREAM} {
			import upstream_transport
		}
	}

	handle {
		reverse_proxy {$WEB_UPSTREAM} {
			import upstream_transport
		}
	}
}
