# Copy to terraform.tfvars (git-ignored) and fill in.
site_domain              = "goliveboard.example.com"
zone_name                = "example.com"
create_zone              = true
bucket_prefix            = "goliveboard-demo-example"
state_bucket             = "goliveboard-terraform-state-example"
github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"
github_repository        = "owner/GoLiveBoard"
alert_email              = "ops@example.com"
monthly_budget_usd       = 50
# Optional: actual spend at which the host and database are stopped.
# Default: twice the budget.
# stop_spending_at_usd   = 100
ai_provider              = "offline"
