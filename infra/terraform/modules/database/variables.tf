variable "name" {
  type = string
}

variable "vpc_id" {
  type = string
}

variable "subnet_ids" {
  description = "Private subnets in at least two zones."
  type        = list(string)
}

variable "client_security_group_id" {
  description = "The security group allowed to connect: the application host's."
  type        = string
}

variable "instance_class" {
  type    = string
  default = "db.t4g.micro"
}

variable "engine_major_version" {
  type    = string
  default = "18"
}

variable "password" {
  description = "The master password; generated by the environment and kept in Parameter Store."
  type        = string
  sensitive   = true
}
