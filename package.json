{
  "name": "opspilot",
  "version": "0.0.0",
  "private": true,
  "description": "Operations platform for teams running high-stakes online events.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run build -w @opspilot/contracts && concurrently --names contracts,api,worker,web --prefix-colors blue,magenta,yellow,green \"npm run dev -w @opspilot/contracts\" \"npm run dev -w @opspilot/api\" \"npm run dev:worker -w @opspilot/api\" \"npm run dev -w @opspilot/web\"",
    "services:up": "docker compose up --detach --wait --wait-timeout 120",
    "services:down": "docker compose down",
    "stack:up": "docker compose --file docker-compose.prod.yml up --build --detach --wait --wait-timeout 180",
    "stack:down": "docker compose --file docker-compose.prod.yml down",
    "db:migrate": "npm run db:migrate -w @opspilot/api --",
    "db:deploy": "npm run db:deploy -w @opspilot/api",
    "db:seed": "npm run db:seed -w @opspilot/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise --config .dependency-cruiser.mjs packages apps",
    "test": "vitest run --project \"!*-int\"",
    "test:int": "vitest run --project \"*-int\"",
    "test:e2e": "playwright test",
    "test:e2e:stack": "E2E_TARGET=stack playwright test",
    "test:watch": "vitest --project \"!*-int\"",
    "test:coverage": "vitest run --project \"!*-int\" --coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run depcruise"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.7",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.1": true,
    "prisma@7.10.1": true,
    "cpu-features": false,
    "fsevents": false,
    "msgpackr-extract": false,
    "protobufjs": false,
    "ssh2": false
  }
}
