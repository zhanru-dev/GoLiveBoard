# The image build copies only what it names (infra/docker/Dockerfile); this
# list keeps the build context small and keeps local secrets and build output
# out of it even if a COPY is widened later.
.git
**/node_modules
**/dist
**/.next
**/*.tsbuildinfo
**/next-env.d.ts
apps/api/src/generated
coverage
playwright-report
test-results
blob-report
.env
.env.*
!.env.example
*.pem
*.log
.DS_Store
