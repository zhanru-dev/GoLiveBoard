// The database schema. Change it, then create a migration with
// `npm run db:migrate -- --name <what-changed>`; never edit applied migrations.
//
// Conventions (docs/03-domain-and-data-model.md):
// - IDs are UUID v7, generated by PostgreSQL 18's uuidv7().
// - Tables and columns are snake_case in SQL, camelCase in TypeScript.
// - Times are timestamptz with millisecond precision, stored in UTC.
// - Email addresses use citext, so uniqueness ignores case.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  ANALYST

  @@map("role")
}

model User {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String    @unique @db.Citext
  name         String
  passwordHash String    @map("password_hash")
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships         Membership[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     TeamInvitation[]

  @@map("users")
}

model Workspace {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String
  /// Days that attendee personal data is kept after an event ends.
  retentionDays Int      @default(90) @map("retention_days")
  isDemo        Boolean  @default(false) @map("is_demo")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships    Membership[]
  invitations    TeamInvitation[]
  activeSessions Session[]

  @@map("workspaces")
}

model Membership {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        Role
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user belongs to a workspace at most once.
  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

/// A signed-in staff browser. The access token names the session; every
/// request reloads it, so revoking it takes effect immediately.
model Session {
  id                       String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  activeWorkspaceId        String    @map("active_workspace_id") @db.Uuid
  /// SHA-256 of the current refresh token; the token itself is never stored.
  refreshTokenHash         String    @unique @map("refresh_token_hash")
  /// The token replaced by the last rotation, to detect reuse of a stolen token.
  previousRefreshTokenHash String?   @unique @map("previous_refresh_token_hash")
  rotatedAt                DateTime? @map("rotated_at") @db.Timestamptz(3)
  refreshExpiresAt         DateTime  @map("refresh_expires_at") @db.Timestamptz(3)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace Workspace @relation(fields: [activeWorkspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activeWorkspaceId])
  @@map("sessions")
}

model TeamInvitation {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  email       String    @db.Citext
  role        Role
  /// SHA-256 of the token in the invitation link.
  tokenHash   String    @unique @map("token_hash")
  invitedById String?   @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([invitedById])
  @@map("team_invitations")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 of the token in the reset link.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}
