// The database schema. Change it, then create a migration with
// `npm run db:migrate -- --name <what-changed>`; never edit applied migrations.
//
// Conventions (docs/03-domain-and-data-model.md):
// - IDs are UUID v7, generated by PostgreSQL 18's uuidv7().
// - Tables and columns are snake_case in SQL, camelCase in TypeScript.
// - Times are timestamptz with millisecond precision, stored in UTC.
// - Email addresses use citext, so uniqueness ignores case.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  previewFeatures     = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MANAGER
  ANALYST

  @@map("role")
}

model User {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String    @unique @db.Citext
  name         String
  passwordHash String    @map("password_hash")
  disabledAt   DateTime? @map("disabled_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships         Membership[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  invitationsSent     TeamInvitation[]
  ownedEvents         Event[]
  auditEntries        AuditEntry[]
  ownedTasks          RunbookTask[]        @relation("TaskOwner")
  completedTasks      RunbookTask[]        @relation("TaskCompletedBy")
  attendeeInvitations AttendeeInvitation[]
  chatMessages        ChatMessage[]        @relation("ChatAuthor")
  deletedMessages     ChatMessage[]        @relation("ChatDeletedBy")
  questions           Question[]

  @@map("users")
}

model Workspace {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  name          String
  /// Days that attendee personal data is kept after an event ends.
  retentionDays Int      @default(90) @map("retention_days")
  isDemo        Boolean  @default(false) @map("is_demo")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  memberships    Membership[]
  invitations    TeamInvitation[]
  activeSessions Session[]
  events         Event[]
  auditEntries   AuditEntry[]
  outboxMessages OutboxMessage[]

  @@map("workspaces")
}

model Membership {
  id          String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  role        Role
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // A user belongs to a workspace at most once.
  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

/// A signed-in staff browser. The access token names the session; every
/// request reloads it, so revoking it takes effect immediately.
model Session {
  id                       String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId                   String    @map("user_id") @db.Uuid
  activeWorkspaceId        String    @map("active_workspace_id") @db.Uuid
  /// SHA-256 of the current refresh token; the token itself is never stored.
  refreshTokenHash         String    @unique @map("refresh_token_hash")
  /// The token replaced by the last rotation, to detect reuse of a stolen token.
  previousRefreshTokenHash String?   @unique @map("previous_refresh_token_hash")
  rotatedAt                DateTime? @map("rotated_at") @db.Timestamptz(3)
  refreshExpiresAt         DateTime  @map("refresh_expires_at") @db.Timestamptz(3)
  revokedAt                DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeWorkspace Workspace @relation(fields: [activeWorkspaceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activeWorkspaceId])
  @@map("sessions")
}

model TeamInvitation {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  email       String    @db.Citext
  role        Role
  /// SHA-256 of the token in the invitation link.
  tokenHash   String    @unique @map("token_hash")
  invitedById String?   @map("invited_by_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt  DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  /// At most one unanswered invitation per address and workspace, so only the
  /// newest link can work (InvitationsService.create revokes the old one).
  @@unique([workspaceId, email], map: "team_invitations_open_key", where: { acceptedAt: null, revokedAt: null })
  @@index([workspaceId])
  @@index([invitedById])
  @@map("team_invitations")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// SHA-256 of the token in the reset link.
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// docs/03-domain-and-data-model.md, section 2. The allowed moves between
/// these states live in src/events/domain/lifecycle.ts.
enum EventStatus {
  DRAFT
  CONFIGURING
  READY
  LIVE
  COMPLETED
  ARCHIVED
  CANCELLED

  @@map("event_status")
}

/// An online event a workspace prepares and runs (FR-EV-1).
/// The migration adds CHECK (ends_at > starts_at), which Prisma cannot express.
model Event {
  id                    String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId           String      @map("workspace_id") @db.Uuid
  /// Used in public URLs instead of the ID: readable title plus a random suffix.
  slug                  String      @unique
  title                 String
  description           String      @default("")
  startsAt              DateTime    @map("starts_at") @db.Timestamptz(3)
  endsAt                DateTime    @map("ends_at") @db.Timestamptz(3)
  /// IANA time zone the event is shown in, e.g. "Europe/London".
  timeZone              String      @map("time_zone")
  ownerUserId           String?     @map("owner_user_id") @db.Uuid
  expectedAttendance    Int?        @map("expected_attendance")
  status                EventStatus @default(DRAFT)
  /// The HLS playback URL from the customer's streaming provider (FR-ST-1).
  streamUrl             String?     @map("stream_url")
  /// Incremented by every change; clients send it back in If-Match.
  version               Int         @default(1)
  /// The last sequence number given out on each real-time channel. Taking
  /// the next one locks the event's row, so numbers are gapless and unique.
  chatSequence          BigInt      @default(0) @map("chat_sequence")
  questionsSequence     BigInt      @default(0) @map("questions_sequence")
  /// FR-RN-4: new questions wait for a moderator before others see them.
  questionsPreModerated Boolean     @default(false) @map("questions_pre_moderated")
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @default(now()) @map("updated_at") @db.Timestamptz(3)

  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner        User?                @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  auditEntries AuditEntry[]
  runbookTasks RunbookTask[]
  accessPolicy AccessPolicy?
  streamChecks StreamCheck[]
  incidents    Incident[]
  assets       Asset[]
  attendees    Attendee[]
  invitations  AttendeeInvitation[]
  chatMessages ChatMessage[]
  questions    Question[]
  journal      RealtimeJournal[]
  attendance   AttendanceMinute[]

  // The event list: one workspace, newest start first, ID as tie-breaker.
  @@index([workspaceId, startsAt(sort: Desc), id(sort: Desc)])
  // Title search with ILIKE '%…%', which a B-tree index cannot serve.
  @@index([title(ops: raw("gin_trgm_ops"))], map: "events_title_trgm_idx", type: Gin)
  @@index([ownerUserId])
  @@map("events")
}

enum ActorKind {
  USER
  ATTENDEE
  SYSTEM

  @@map("actor_kind")
}

/// Who did what, when, with before and after values (FR-RC-1). Written in the
/// same transaction as the change it records, and never holds secrets or
/// attendee email addresses.
model AuditEntry {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  eventId     String?   @map("event_id") @db.Uuid
  actorKind   ActorKind @map("actor_kind")
  actorUserId String?   @map("actor_user_id") @db.Uuid
  /// What happened, as `<target>.<verb>`: "event.created", "event.transitioned".
  action      String
  targetType  String    @map("target_type")
  targetId    String    @map("target_id") @db.Uuid
  before      Json?
  after       Json?
  requestId   String?   @map("request_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event     Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  actorUser User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc)])
  @@index([workspaceId, eventId, createdAt(sort: Desc)])
  @@index([eventId])
  @@index([actorUserId])
  @@map("audit_entries")
}

/// The stored response to a create that carried an Idempotency-Key, so a
/// retry returns the original response instead of creating a duplicate.
model IdempotencyRecord {
  /// Who and what the key belongs to, e.g. "<workspace>:<user>:create-event".
  scope          String
  key            String   @db.Uuid
  /// SHA-256 of the request body, to refuse the same key with another body.
  requestHash    String   @map("request_hash")
  responseStatus Int      @map("response_status")
  responseBody   Json     @map("response_body")
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([scope, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

enum TaskStatus {
  TODO
  DONE

  @@map("task_status")
}

/// One step of an event's runbook (FR-LC-1). Writes lock the event row, so
/// positions stay unique per event and readiness sees a consistent runbook.
model RunbookTask {
  id            String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId       String     @map("event_id") @db.Uuid
  title         String
  /// An open critical task is a hard blocker (FR-LC-3).
  isCritical    Boolean    @default(false) @map("is_critical")
  status        TaskStatus @default(TODO)
  /// 1, 2, 3… in display order; renumbered when a task moves.
  position      Int
  ownerUserId   String?    @map("owner_user_id") @db.Uuid
  dueAt         DateTime?  @map("due_at") @db.Timestamptz(3)
  completedAt   DateTime?  @map("completed_at") @db.Timestamptz(3)
  completedById String?    @map("completed_by_id") @db.Uuid
  version       Int        @default(1)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  event       Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  owner       User? @relation("TaskOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  completedBy User? @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([eventId, position])
  @@index([ownerUserId])
  @@index([completedById])
  @@map("runbook_tasks")
}

enum AccessMode {
  PUBLIC
  EMAIL_DOMAIN
  INVITE_ONLY

  @@map("access_mode")
}

/// Who may register for an event (FR-AD-2). Missing policy = hard blocker.
model AccessPolicy {
  eventId              String     @id @map("event_id") @db.Uuid
  mode                 AccessMode
  /// Lower-case domains; only used, and then required, for EMAIL_DOMAIN.
  allowedDomains       String[]   @default([]) @map("allowed_domains")
  /// The privacy notice attendees agree to when they register (FR-AD-6).
  privacyNoticeVersion String     @map("privacy_notice_version")
  version              Int        @default(1)
  updatedAt            DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("access_policies")
}

/// One fetch of the event's stream manifest by the worker (FR-ST-2).
model StreamCheck {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  /// The URL that was checked, so checks of an old URL never count for a new one.
  url        String
  /// The time the check was scheduled for: the 30-second slot, or the moment
  /// a manager asked for it. Unique per event, so a job that runs twice
  /// records one check.
  slot       DateTime @db.Timestamptz(3)
  checkedAt  DateTime @map("checked_at") @db.Timestamptz(3)
  ok         Boolean
  /// Null when no response arrived (DNS failure, timeout, refused address).
  httpStatus Int?     @map("http_status")
  latencyMs  Int      @map("latency_ms")
  /// Why the check failed, in words safe to show to staff.
  failure    String?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, slot])
  // The latest check per event, for readiness and the check history.
  @@index([eventId, checkedAt(sort: Desc)])
  @@map("stream_checks")
}

enum IncidentKind {
  STREAM_UNREACHABLE

  @@map("incident_kind")
}

model Incident {
  id         String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId    String       @map("event_id") @db.Uuid
  kind       IncidentKind
  openedAt   DateTime     @map("opened_at") @db.Timestamptz(3)
  resolvedAt DateTime?    @map("resolved_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  /// At most one open incident of a kind per event, even if two checks race.
  @@unique([eventId, kind], map: "incidents_open_key", where: { resolvedAt: null })
  @@index([eventId, openedAt(sort: Desc)])
  @@map("incidents")
}

enum AssetKind {
  HOLDING_SLATE

  @@map("asset_kind")
}

enum AssetStatus {
  PENDING
  READY
  REJECTED

  @@map("asset_status")
}

/// A file in object storage, uploaded by the browser with a presigned URL.
model Asset {
  id          String      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId     String      @map("event_id") @db.Uuid
  kind        AssetKind
  storageKey  String      @unique @map("storage_key")
  status      AssetStatus @default(PENDING)
  /// Declared when the upload starts and signed into the upload URL; checked
  /// against the stored file's first bytes and size when it completes.
  contentType String      @map("content_type")
  sizeBytes   Int         @map("size_bytes")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @default(now()) @map("updated_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, kind, status])
  @@map("assets")
}

/// docs/03-domain-and-data-model.md, section 4.3. The rules for moving
/// between these live in src/attendees/domain.
enum AttendeeStatus {
  /// Registered; the email address is not verified yet.
  PENDING
  /// Verified: may receive reminders and, while eligible, join the event.
  VERIFIED
  /// A Manager revoked their access (FR-AD-4).
  REVOKED
  /// Anonymised, on request or when the retention period ended (FR-AD-6).
  ERASED

  @@map("attendee_status")
}

/// Someone who registered for an event (FR-AD-3). Personal data (name and
/// email) is anonymised on request or once the workspace's retention period
/// after the event has passed; the row stays, so counts and authorship do.
model Attendee {
  id                   String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId              String         @map("event_id") @db.Uuid
  /// After anonymisation a random placeholder under `.invalid`.
  email                String         @db.Citext
  name                 String
  status               AttendeeStatus @default(PENDING)
  /// The privacy notice version shown when they registered (FR-AD-6).
  consentNoticeVersion String         @map("consent_notice_version")
  consentedAt          DateTime       @map("consented_at") @db.Timestamptz(3)
  remindersOptIn       Boolean        @default(true) @map("reminders_opt_in")
  verifiedAt           DateTime?      @map("verified_at") @db.Timestamptz(3)
  revokedAt            DateTime?      @map("revoked_at") @db.Timestamptz(3)
  erasedAt             DateTime?      @map("erased_at") @db.Timestamptz(3)
  /// Demo workspace only: SHA-256 of the key in the registering browser's
  /// demo-inbox cookie. Mail to this attendee goes to that inbox instead of
  /// being sent.
  demoInboxKeyHash     String?        @map("demo_inbox_key_hash")
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)

  event              Event                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  verificationTokens AttendeeVerificationToken[]
  sessions           AttendeeSession[]
  reminders          ReminderDelivery[]
  demoInboxMessages  DemoInboxMessage[]
  chatMessages       ChatMessage[]
  questions          Question[]
  votes              QuestionVote[]
  attendance         AttendanceMinute[]

  /// One registration per address and event.
  @@unique([eventId, email])
  @@index([eventId, status])
  @@index([demoInboxKeyHash])
  @@map("attendees")
}

/// An address invited to an invitation-only event (FR-AD-4). Revoking it
/// also revokes the attendee who registered with it.
model AttendeeInvitation {
  id          String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId     String    @map("event_id") @db.Uuid
  email       String    @db.Citext
  invitedById String?   @map("invited_by_id") @db.Uuid
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  invitedBy User? @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  /// At most one live invitation per address and event.
  @@unique([eventId, email], map: "attendee_invitations_live_key", where: { revokedAt: null })
  @@index([eventId])
  @@index([invitedById])
  @@map("attendee_invitations")
}

/// The link that verifies an attendee's email address and signs them in
/// (FR-AD-3): single-use, valid for 15 minutes, stored only as a hash.
model AttendeeVerificationToken {
  id         String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  attendeeId String    @map("attendee_id") @db.Uuid
  /// SHA-256 of the token in the link.
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@index([attendeeId])
  @@index([expiresAt])
  @@map("attendee_verification_tokens")
}

/// A verified attendee's browser. The cookie carries an opaque token; only
/// its hash is stored. Every attendee request reloads the session and
/// re-checks eligibility, so a revocation or policy change applies at once.
model AttendeeSession {
  id         String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  attendeeId String   @map("attendee_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@index([attendeeId])
  @@index([expiresAt])
  @@map("attendee_sessions")
}

enum ReminderKind {
  /// 24 hours before the start.
  DAY_BEFORE
  /// 1 hour before the start.
  HOUR_BEFORE

  @@map("reminder_kind")
}

/// A reminder that was sent (FR-AD-5). Inserted before sending, and the
/// primary key allows one per attendee and kind, so a job that runs twice
/// sends it at most once.
model ReminderDelivery {
  attendeeId String       @map("attendee_id") @db.Uuid
  kind       ReminderKind
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@id([attendeeId, kind])
  @@map("reminder_deliveries")
}

/// Demo workspace only: an email to an attendee, kept for the demo inbox of
/// the browser that registered them instead of being sent (FR-AUTH-5).
model DemoInboxMessage {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  attendeeId   String   @map("attendee_id") @db.Uuid
  /// The inbox it belongs to: SHA-256 of that browser's demo-inbox key, as
  /// when the message was written. A later registration of the same address
  /// from another browser does not reveal it.
  inboxKeyHash String   @map("inbox_key_hash")
  subject      String
  text         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@index([attendeeId])
  @@index([inboxKeyHash, createdAt])
  @@map("demo_inbox_messages")
}

/// The real-time channels of an event (docs/04, section 4).
enum RealtimeChannel {
  CHAT
  QUESTIONS

  @@map("realtime_channel")
}

/// A chat message (FR-RN-2). Written by an attendee or a staff member, never
/// both (CHECK in the migration). A deleted message keeps its row as a
/// tombstone with its text removed (FR-RN-3).
model ChatMessage {
  id               String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId          String    @map("event_id") @db.Uuid
  /// Its place on the event's chat channel.
  sequence         BigInt
  authorAttendeeId String?   @map("author_attendee_id") @db.Uuid
  authorUserId     String?   @map("author_user_id") @db.Uuid
  /// Chosen by the client; a retried send with the same ID and author
  /// returns the stored message (unique index in the migration).
  clientMessageId  String    @map("client_message_id") @db.Uuid
  /// Empty once deleted.
  body             String
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(3)
  deletedById      String?   @map("deleted_by_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorAttendee Attendee? @relation(fields: [authorAttendeeId], references: [id], onDelete: Cascade)
  authorUser     User?     @relation("ChatAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  deletedBy      User?     @relation("ChatDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  @@unique([eventId, sequence])
  @@index([authorAttendeeId])
  @@index([authorUserId])
  @@index([deletedById])
  @@map("chat_messages")
}

enum QuestionStatus {
  /// Waiting for a moderator (pre-moderation): only its author and
  /// moderators see it.
  PENDING
  PUBLISHED
  HIDDEN
  ANSWERED

  @@map("question_status")
}

/// A question for the speakers (FR-RN-4, FR-RN-5).
model Question {
  id               String         @id @default(dbgenerated("uuidv7()")) @db.Uuid
  eventId          String         @map("event_id") @db.Uuid
  authorAttendeeId String?        @map("author_attendee_id") @db.Uuid
  authorUserId     String?        @map("author_user_id") @db.Uuid
  body             String
  status           QuestionStatus
  /// 1 to 3 while pinned; unique per event (FR-RN-5, enforced by the
  /// database: CHECK and a partial unique index in the migration).
  pinSlot          Int?           @map("pin_slot") @db.SmallInt
  /// Set when AI triage merges it into another question (milestone 8).
  mergedIntoId     String?        @map("merged_into_id") @db.Uuid
  /**
   * When it was first published or answered, if ever. A change to a question
   * that has never been public reaches others as a WITHDRAWN placeholder
   * without its ID (they have nothing of it to remove).
   */
  firstPublishedAt DateTime?      @map("first_published_at") @db.Timestamptz(3)
  /// Kept equal to the number of votes in the same transaction as each vote.
  voteCount        Int            @default(0) @map("vote_count")
  version          Int            @default(1)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @default(now()) @map("updated_at") @db.Timestamptz(3)

  event          Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorAttendee Attendee?      @relation(fields: [authorAttendeeId], references: [id], onDelete: Cascade)
  authorUser     User?          @relation(fields: [authorUserId], references: [id], onDelete: SetNull)
  mergedInto     Question?      @relation("QuestionMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  merged         Question[]     @relation("QuestionMerge")
  votes          QuestionVote[]

  /// FR-RN-5: one question per pin slot and event (with the 1–3 CHECK).
  @@unique([eventId, pinSlot], map: "questions_pin_slot_key", where: { pinSlot: { not: null } })
  @@index([eventId, status, voteCount(sort: Desc)])
  @@index([authorAttendeeId])
  @@index([authorUserId])
  @@index([mergedIntoId])
  @@map("questions")
}

/// One attendee's vote for one question (FR-RN-4): the primary key allows
/// one each.
model QuestionVote {
  questionId String   @map("question_id") @db.Uuid
  attendeeId String   @map("attendee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@id([questionId, attendeeId])
  @@index([attendeeId])
  @@map("question_votes")
}

/// Everything that happened on an event's real-time channels, in order: a
/// client that reconnects asks for what came after the last sequence it
/// applied (docs/04, section 4). Written in the transaction that makes the
/// change, with the sequence it took from the event's row.
model RealtimeJournal {
  eventId   String          @map("event_id") @db.Uuid
  channel   RealtimeChannel
  sequence  BigInt
  /// What happened, e.g. MESSAGE_CREATED.
  kind      String
  /// The message or question it happened to.
  entityId  String          @map("entity_id") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([eventId, channel, sequence])
  @@map("realtime_journal")
}

/// A change to who may take part in live interaction, written in the
/// transaction that makes it. Every API instance reads the recent ones every
/// second and re-checks the connections they concern: a revocation ends live
/// connections within seconds without depending on a message broker
/// (FR-AD-4). Rows older than an hour are deleted.
model AccessChange {
  id        BigInt   @id @default(autoincrement())
  /// `{ type: "recheck", scope, ids }` or `{ type: "status", eventId, slug, status }`.
  change    Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("access_changes")
}

/// An attendee watched during this minute (heartbeats every 30 seconds):
/// the audience figures of the operations room and the report (milestone 7).
model AttendanceMinute {
  eventId    String   @map("event_id") @db.Uuid
  attendeeId String   @map("attendee_id") @db.Uuid
  minute     DateTime @db.Timestamptz(3)

  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendee Attendee @relation(fields: [attendeeId], references: [id], onDelete: Cascade)

  @@id([eventId, attendeeId, minute])
  @@index([attendeeId])
  @@map("attendance_minutes")
}

/// Stored files to delete once nothing can write to them any more: the
/// storage prefixes of events the demo reset deleted (FR-AUTH-5). An upload
/// link handed out before the reset works until `notBefore`. The maintenance
/// sweep then deletes the prefix's files and the row; while storage fails,
/// the row stays and every later sweep tries again.
model PendingFilePurge {
  prefix    String   @id
  notBefore DateTime @map("not_before") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([notBefore])
  @@map("pending_file_purges")
}

/// A side effect to perform once the change that caused it has committed
/// (ADR-0007). Written in the same transaction as the change; the worker's
/// relay turns it into a job.
model OutboxMessage {
  id           String    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  workspaceId  String    @map("workspace_id") @db.Uuid
  /// What happened, e.g. "event.transitioned".
  type         String
  payload      Json
  traceContext Json?     @map("trace_context")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// The relay's queue: undispatched messages, oldest first.
  @@index([createdAt], map: "outbox_messages_undispatched_idx", where: { dispatchedAt: null })
  @@index([workspaceId])
  @@map("outbox_messages")
}
