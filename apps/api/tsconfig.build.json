{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    // The build compiles only this app. Workspace packages are used through
    // their own build output (dist), exactly as Node.js loads them at runtime.
    "customConditions": []
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/testing"]
}
