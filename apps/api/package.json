{
  "name": "@opspilot/api",
  "version": "0.0.0",
  "private": true,
  "description": "OpsPilot HTTP API (NestJS).",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env --enable-source-maps --import ./dist/telemetry.js\"",
    "dev:worker": "node --env-file-if-exists=../../.env --enable-source-maps --import ./dist/telemetry.js --watch-path=dist dist/worker.js",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps --import ./dist/telemetry.js dist/main.js",
    "start:worker": "node --env-file-if-exists=../../.env --enable-source-maps --import ./dist/telemetry.js dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=../../.env --enable-source-maps dist/demo/seed.js",
    "db:reset": "prisma migrate reset",
    "eval:record": "npm run build -w @opspilot/contracts && nest build && node --env-file-if-exists=../../.env --enable-source-maps dist/triage/eval/record.js && prettier --write src/triage/eval/recordings"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.12.0",
    "@aws-sdk/client-s3": "^3.1175.0",
    "@aws-sdk/client-sesv2": "^3.1175.0",
    "@aws-sdk/s3-request-presigner": "^3.1175.0",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@node-rs/argon2": "^2.2.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "0.301.2",
    "@opentelemetry/exporter-metrics-otlp-http": "0.301.2",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation": "0.301.2",
    "@opentelemetry/instrumentation-express": "0.73.0",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/instrumentation-ioredis": "0.73.0",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/instrumentation-pino": "0.71.0",
    "@opentelemetry/instrumentation-undici": "0.35.1",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-logs": "3.1.1",
    "@opentelemetry/sdk-metrics": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "@opentelemetry/sdk-trace": "3.1.1",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@opspilot/contracts": "0.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/node": "^11.16.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bullmq": "^6.7.8",
    "bullmq-otel": "2.0.1",
    "cookie": "~2.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.18",
    "nestjs-pino": "^5.3.2",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.0",
    "@opentelemetry/context-async-hooks": "3.1.1",
    "@testcontainers/postgresql": "^12.2.2",
    "@testcontainers/valkey": "^12.2.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "vitest": "^5.1.0"
  }
}
