{
  "name": "@opspilot/api",
  "version": "0.0.0",
  "private": true,
  "description": "OpsPilot HTTP API (NestJS).",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "dev": "nest start --watch --exec \"node --env-file-if-exists=../../.env --enable-source-maps\"",
    "dev:worker": "node --env-file-if-exists=../../.env --enable-source-maps --watch-path=dist dist/worker.js",
    "start": "node --env-file-if-exists=../../.env --enable-source-maps dist/main.js",
    "start:worker": "node --env-file-if-exists=../../.env --enable-source-maps dist/worker.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node --env-file-if-exists=../../.env --enable-source-maps dist/demo/seed.js",
    "db:reset": "prisma migrate reset"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-express": "^12.4.2",
    "@node-rs/argon2": "^2.2.2",
    "@opspilot/contracts": "0.0.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/node": "^11.12.0",
    "bullmq": "^6.7.6",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.4.2",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/valkey": "^12.2.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "vitest": "^5.1.0"
  }
}
