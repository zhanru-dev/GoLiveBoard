{
  "name": "@goliveboard/web",
  "version": "0.0.0",
  "private": true,
  "description": "GoLiveBoard web application (Next.js).",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --hostname ${WEB_HOST:-127.0.0.1} --port 3301",
