# Copy to .env and adjust: `cp .env.example .env`.
# Used by the API (`npm run dev`) and by Docker Compose (`npm run services:up`).

# Ports on your machine. Change them here if another project already uses one.
PROXY_PORT=3300
API_PORT=4301
POSTGRES_PORT=5443
VALKEY_PORT=6392
MAILPIT_SMTP_PORT=1036
MAILPIT_UI_PORT=8036
S3_PORT=8333

# API
NODE_ENV=development
API_HOST=127.0.0.1
# Caddy sits in front of the API: take client addresses from X-Forwarded-For.
TRUST_PROXY_HOPS=1
# Real-time: how often every connection is re-checked (ms), and the prefix of
# its Valkey channels (deployments sharing a Valkey need different ones).
# REALTIME_SWEEP_MS=30000
# REALTIME_CHANNEL_PREFIX=opspilot
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# json (machines) | pretty (people); production requires json
LOG_FORMAT=pretty
# Local credentials from docker-compose.yml; never use these anywhere else.
# If you change POSTGRES_PORT or VALKEY_PORT above, change these URLs too.
DATABASE_URL=postgres://opspilot:opspilot@127.0.0.1:5443/opspilot
VALKEY_URL=redis://127.0.0.1:6392

# Where browsers open the app; state-changing requests must come from it.
APP_ORIGIN=http://localhost:3300
# Signs session tokens. Any 32+ character string works locally; in production
# it is a random value from Parameter Store (`openssl rand -base64 48`).
JWT_SECRET=local-development-signing-key-not-a-secret
# Seals webhook signing secrets (32 bytes, base64); without it, webhook
# endpoints cannot be created. Generate one and uncomment:
#   openssl rand -base64 32
# WEBHOOK_ENCRYPTION_KEY=
# Mailpit catches email locally (inbox: http://localhost:8036).
SMTP_URL=smtp://127.0.0.1:1036
MAIL_FROM="OpsPilot <no-reply@opspilot.local>"

# Object storage: SeaweedFS locally (credentials in infra/docker/seaweedfs-s3.json).
# Browsers upload straight to S3_PUBLIC_ENDPOINT with presigned URLs. In
# production these point at Amazon S3 and credentials come from the instance role.
S3_ENDPOINT=http://127.0.0.1:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_BUCKET=opspilot-assets
S3_ACCESS_KEY_ID=opspilot
S3_SECRET_ACCESS_KEY=opspilot-local-only
S3_FORCE_PATH_STYLE=true
# Create the bucket and its CORS rule at start-up (local only).
S3_CREATE_BUCKET=true

# Error reporting (Sentry), for the API, the worker, the web server and the
# browser. Off when SENTRY_DSN is unset, as it usually is locally.
# SENTRY_DSN=https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=

# Traces (OpenTelemetry, ADR-0011): the API and the worker send them to this
# OTLP/HTTP collector. Off when unset. Locally, the grafana/otel-lgtm
# container listens on 4318.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Demo mode (FR-AUTH-5): "Try the demo" on the sign-in page, and the nightly
# reset of the shared demo workspace. `npm run db:seed` loads it at once.
# DEMO_MODE=true

# AI question triage (FR-RN-6). "none" (the default) keeps suggestions off;
# Q&A works as ever. "offline" groups identical questions with no model, for
# development. "anthropic" uses Claude and needs an API key.
# AI_PROVIDER=none
# ANTHROPIC_API_KEY=
# AI_TRIAGE_MODEL=claude-opus-5-5
