# Copy to .env and adjust: `cp .env.example .env`.
# Every variable has a working local default, so .env is optional for now.

# API
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4301
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# json (machines) | pretty (people); production requires json
LOG_FORMAT=pretty
