# Copy to .env and adjust: `cp .env.example .env`.
# Used by the API (`npm run dev`) and by Docker Compose (`npm run services:up`).

# Ports on your machine. Change them here if another project already uses one.
PROXY_PORT=3300
API_PORT=4301
POSTGRES_PORT=5443
VALKEY_PORT=6392

# API
NODE_ENV=development
API_HOST=127.0.0.1
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug
# json (machines) | pretty (people); production requires json
LOG_FORMAT=pretty
# Local credentials from docker-compose.yml; never use these anywhere else.
# If you change POSTGRES_PORT or VALKEY_PORT above, change these URLs too.
DATABASE_URL=postgres://opspilot:opspilot@127.0.0.1:5443/opspilot
VALKEY_URL=redis://127.0.0.1:6392
