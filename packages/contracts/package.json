{
  "name": "@opspilot/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Schemas and types shared by the web app, the API and the worker.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@opspilot/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  }
}
